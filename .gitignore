# ---------------------------------------------------------------------------
# Institution-internal material. These must never reach the public repository.
# ---------------------------------------------------------------------------
# Query files hold the originating institution's schema, table and column names.
sql/
*.sql

# Environment files may hold DB_URL and therefore credentials.
.env
.env.*
*.envrc

# ---------------------------------------------------------------------------
# Analysis intermediates and outputs. Patient-level, not release artefacts.
# ---------------------------------------------------------------------------
output/
outputs/
data/
*.csv
*.tsv
*.parquet
*.pq
*.xlsx
*.xls

# Trained models, scalers and calibrators.
*.joblib
*.pt
*.pth
*.zip

# Figures generated by a run.
*.png
*.pdf

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Repository files that must always be tracked, even though the patterns above
# would otherwise exclude them.
# ---------------------------------------------------------------------------
!LICENSE
!README.md
!requirements.txt
!.gitignore
